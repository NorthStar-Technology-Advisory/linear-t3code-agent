[Unit]
Description=Linear T3 Code Webhook Filter/Forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/linear-t3code-agent
EnvironmentFile=%h/linear-t3code-agent/.env
Environment=PATH=REPLACE_WITH_SERVICE_ACCOUNT_PATH
ExecStart=REPLACE_WITH_ABSOLUTE_NODE24_PATH dist/server.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
UMask=0077

[Install]
WantedBy=default.target
