{
  "name": "linear-t3code-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "doctor": "tsx src/doctor.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Signed Linear webhook filter and forwarder for native T3 Code orchestration"
}
