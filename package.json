{
  "name": "linear-t3code-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "tsx src/onboarding.ts setup",
    "doctor": "tsx src/onboarding.ts doctor",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke:linear": "tsx src/linear-smoke.ts",
    "smoke:webhook": "tsx src/webhook-smoke.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
