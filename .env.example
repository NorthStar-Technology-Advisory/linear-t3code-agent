LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
INSTALL_SECRET=
LINEAR_REDIRECT_URI=https://your-domain.example/linear/oauth/callback
BASE_URL=https://your-domain.example

# Existing private T3Code environment; bearer credential with orchestration:read/write.
T3CODE_URL=http://127.0.0.1:3773
T3CODE_TOKEN=
# Provider instance ID and model as configured in that T3Code environment.
T3CODE_PROVIDER=codex
T3CODE_MODEL=your-model-id
# JSON keyed by Linear PROJECT UUID (not its team or human-readable name).
PROJECT_ROUTES='{"linear-project-uuid":{"repository":"/absolute/path/to/repo","t3ProjectId":"t3-project-id","baseBranch":"main"}}'

BRIDGE_DB_PATH=./data/bridge.sqlite
WORKTREE_ROOT=./data/worktrees
MAX_CONCURRENT_SESSIONS=1
POLL_INTERVAL_MS=1000
PR_POLL_INTERVAL_MS=60000
PROGRESS_DEBOUNCE_MS=3000
PROGRESS_HEARTBEAT_MS=300000
HOST=127.0.0.1
PORT=8787
TOKEN_STORE_PATH=./data/linear-tokens.json
STATE_STORE_PATH=./data/oauth-states.json
