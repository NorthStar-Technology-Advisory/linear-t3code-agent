# Incoming Linear webhook secret (not an API/OAuth token).
LINEAR_WEBHOOK_SECRET=
# Full private URL of the existing native T3 webhook task.
T3_WEBHOOK_URL=
# Optional: destination HMAC secret, if it differs from Linear's source secret.
# T3_WEBHOOK_SECRET=
FORWARDER_POLICY_PATH=./data/forwarder-policy.json
# This must be a new receipt database, NOT data/bridge.sqlite.
FORWARDER_DB_PATH=./data/forwarder.sqlite
HOST=127.0.0.1
PORT=8787
FORWARD_TIMEOUT_MS=3000
MAX_DELIVERY_AGE_MS=300000
