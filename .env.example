LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
# Set this to the same random secret entered in the GitHub repository webhook.
GITHUB_WEBHOOK_SECRET=
INSTALL_SECRET=
LINEAR_REDIRECT_URI=https://your-domain.example/linear/oauth/callback
BASE_URL=https://your-domain.example

# Existing private T3Code environment; bearer credential with orchestration:read and orchestration:operate.
T3CODE_URL=http://127.0.0.1:3773
T3CODE_TOKEN=
# Provider/model and workspace preferences are inherited from T3Code.
# In Linear, select a child label in the "T3Code project" project label group.
# Its plain-text name must exactly match one active T3Code project title.

BRIDGE_DB_PATH=./data/bridge.sqlite

# Private context/attachment storage; T3Code chooses new worktree locations.
WORKTREE_ROOT=./data/worktrees
MAX_CONCURRENT_SESSIONS=1
POLL_INTERVAL_MS=1000
PR_POLL_INTERVAL_MS=60000
PROGRESS_DEBOUNCE_MS=3000
PROGRESS_HEARTBEAT_MS=300000
HOST=127.0.0.1
PORT=8787
TOKEN_STORE_PATH=./data/linear-tokens.json
STATE_STORE_PATH=./data/oauth-states.json
